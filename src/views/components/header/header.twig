{#
| Variable          | Type   | Description                          |
|--------------------|--------|---------------------------------------|
| cart               | object |                                        |
| cart.items_count   | int    |                                        |
| cart.total         | string | Formatted total ex: "١٠٠ ر.س"        |
#}
{% set important_links = theme.settings.get('important_links') %}

{# Announcement Bar #}
{% set announcement_bar = theme.settings.get('announcement_bar') %}
{% set announcement_enabled = theme.settings.get('announcement_bar_enabled') %}
{% if announcement_enabled and announcement_bar %}
<div style="background:var(--color-primary);color:#fff;font-size:13px;text-align:center;padding:9px 12px;line-height:1.5;">
  {{ announcement_bar|raw }}
</div>
{% endif %}

<header data-testid="store-header" class="store-header" style="background:#fff;border-bottom:1px solid var(--color-light-grey);">

  {# Main utility row: logo, search, account/cart #}
  <div style="display:flex;align-items:center;gap:20px;padding:16px 24px;max-width:1400px;margin:0 auto;flex-wrap:wrap;">

    {# Logo #}
    <a data-testid="store-header-logo" class="navbar-brand" href="{{ store.url }}" style="display:flex;align-items:center;flex-shrink:0;">
      <img fetchpriority="high" width="140" height="40" loading="eager" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }}" style="height:38px;width:auto;object-fit:contain;">
      {% if is_page('index') %}
        <h1 class="sr-only">{{ store.name }}</h1>
      {% else %}
        <h2 class="sr-only">{{ store.name }}</h2>
      {% endif %}
    </a>

    {# Mobile menu toggle #}
    <a data-testid="store-header-mobile-toggle" class="lg:hidden" href="#mobile-menu" aria-label="القائمة" style="display:none;">
      <i class="sicon-menu" style="font-size:22px;color:var(--main-text-color);"></i>
    </a>

    {# Search bar #}
    <div style="flex:1;min-width:220px;">
      <salla-search data-testid="store-header-search" inline oval height="44"
        style="--search-bg:var(--color-grey);--search-border:1.5px solid var(--color-light-grey);--search-radius:10px;"></salla-search>
    </div>

    {# Right side: track order / account / cart #}
    <div style="display:flex;align-items:center;gap:18px;font-size:14px;font-weight:500;color:var(--main-text-color);flex-shrink:0;">

      {% if important_links %}
        <salla-menu data-testid="store-header-topnav" source="footer" topnav style="font-size:14px;"></salla-menu>
      {% endif %}

      <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger></salla-user-menu>

      <salla-cart-summary data-testid="store-header-cart" class="cart-pill">
        <div slot="icon" style="display:flex;align-items:center;gap:7px;background:var(--main-text-color);color:#fff;border-radius:10px;padding:10px 16px;font-size:14px;font-weight:600;">
          <span>السلة</span>
          <i class="header-btn__icon icon sicon-shopping-bag"></i>
        </div>
      </salla-cart-summary>

    </div>

  </div>

  {# Categories nav #}
  <div id="mainnav" class="main-nav-container" style="border-top:1px solid var(--color-light-grey);">
    <div style="max-width:1400px;margin:0 auto;padding:13px 24px;">
      <div style="display:flex;align-items:center;gap:26px;font-size:14px;font-weight:500;color:var(--color-text);overflow-x:auto;">
        <custom-main-menu></custom-main-menu>
      </div>
    </div>
  </div>

</header>