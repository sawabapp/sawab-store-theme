{#
| Variable          | Type   | Description                          |
|--------------------|--------|---------------------------------------|
| cart               | object |                                        |
| cart.items_count   | int    |                                        |
| cart.total         | string | Formatted total ex: "١٠٠ ر.س"        |
#}
{% set announcement_items = theme.settings.get('announcement_items')|default([]) %}
{% set announcement_speed = theme.settings.get('announcement_speed')|default('normal') %}
{% set announcement_bg = theme.settings.get('announcement_bg')|default('#c62127') %}
{% set announcement_fg = theme.settings.get('announcement_text_color')|default('#ffffff') %}
{% set announcement_icon_bg = theme.settings.get('announcement_icon_bg')|default('#ffffff') %}
{% set announcement_icon_fg = theme.settings.get('announcement_icon_color')|default('#c62127') %}
{% set announcement_enabled = theme.settings.get('announcement_bar_enabled') %}
{% set announcement_copy_enabled = theme.settings.get('announcement_copy_code_enabled') %}
{% set announcement_copy_code = theme.settings.get('announcement_copy_code') %}
{% set important_links = theme.settings.get('important_links') %}
{% set sticky_header_enabled = theme.settings.get('sticky_header_enabled')|default(true) %}

{# نصوص الهيدر بلغتين. «السلة» من مفاتيح سلة نفسها فتُترجم عبر trans، وما دونها
   لا مفتاح مؤكّدًا له فنشتقّه من لغة الصفحة (انظر CLAUDE.md) #}
{% set sawab_ar = (language.code|default('ar')) == 'ar' %}
{% set t_search = sawab_ar ? 'بحث' : 'Search' %}
{% set t_account = sawab_ar ? 'حسابي' : 'My account' %}
{% set t_localization = sawab_ar ? 'اللغة والعملة' : 'Language & currency' %}
{% set t_menu = sawab_ar ? 'القائمة' : 'Menu' %}
{% set t_copy_code = sawab_ar ? 'نسخ الكود' : 'Copy code' %}
{% set t_copied = sawab_ar ? 'تم النسخ' : 'Copied' %}
{% set t_copy_aria = sawab_ar ? 'نسخ كود الخصم' : 'Copy discount code' %}

{# الشريط الإعلاني: إعلانات متعدّدة تتحرّك في مسار واحد، يفصل بينها أيقونة داخل
   دائرة. المسار مكرّر مرّتين ليبدو الدوران متصلًا بلا قفزة عند نهايته، والنسخة
   الثانية مخفيّة عن القارئات الصوتية حتى لا يُقرأ النص مرّتين. الألوان تمرّ
   كمتغيّرات CSS مضمّنة لأنها إعدادات تاجر لا قيم ثابتة #}
{% if announcement_enabled and announcement_items|length %}
<div
  class="announcement-bar announcement-bar--speed-{{ announcement_speed }}"
  style="--ann-bg: {{ announcement_bg }}; --ann-fg: {{ announcement_fg }}; --ann-icon-bg: {{ announcement_icon_bg }}; --ann-icon-fg: {{ announcement_icon_fg }};"
>
  <div class="announcement-bar__viewport">
    <div class="announcement-bar__track">
      {% for pass in 1..2 %}
        <div class="announcement-bar__seq"{{ pass == 2 ? ' aria-hidden="true"' : '' }}>
          {% for item in announcement_items %}
            <span class="announcement-bar__item">
              <span class="announcement-bar__text">{{ item.text }}</span>
              <span class="announcement-bar__sep" aria-hidden="true">
                <i class="{{ item.icon|default('sicon-shipping-fast') }}"></i>
              </span>
            </span>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>

  {% if announcement_copy_enabled and announcement_copy_code %}
    <button type="button" class="announcement-bar__copy-btn" onclick="app.copyToClipboard(event)" data-content="{{ announcement_copy_code }}" aria-label="{{ t_copy_aria }}">
      <i class="sicon-swap-fill"></i>
      <span class="announcement-bar__copy-label">{{ t_copy_code }}</span>
      <span class="announcement-bar__copy-label--copied">{{ t_copied }}</span>
    </button>
  {% endif %}
</div>
{% endif %}

<header data-testid="store-header" class="store-header site-header{{ sticky_header_enabled ? ' js-sticky-header' : '' }}">
  <div class="site-header__row">

    <a data-testid="store-header-mobile-toggle" class="site-header__mobile-toggle lg:hidden mburger mburger--collapse leading-none" href="#mobile-menu" aria-label="{{ t_menu }}">
      <i class="sicon-menu"></i>
    </a>

    <a data-testid="store-header-logo" class="site-header__logo" href="{{ store.url }}">
      <img fetchpriority="high" width="140" height="40" loading="eager" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }}">
      {% if is_page('index') %}
        <h1 class="sr-only">{{ store.name }}</h1>
      {% else %}
        <h2 class="sr-only">{{ store.name }}</h2>
      {% endif %}
    </a>

    <div class="site-header__search">
      <salla-search data-testid="store-header-search" inline height="44"></salla-search>
      <button type="button" class="site-header__search-btn" data-submit-search>{{ t_search }}</button>
    </div>

    <div class="site-header__mobile-actions-group">
      <button type="button" class="site-header__search-mobile-icon" aria-label="{{ t_search }}" data-open-search>
        <i class="sicon-search"></i>
      </button>

      <div class="site-header__actions">
        {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
          <button type="button" class="site-header__lang" aria-label="{{ t_localization }}" data-open-localization>
            <i class="sicon-lang"></i>
          </button>
        {% endif %}

        <a href="{{ routes.account_url|default('#') }}" class="site-header__account">
          <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger></salla-user-menu>
          <span class="site-header__account-label">{{ t_account }}</span>
        </a>

        <salla-cart-summary data-testid="store-header-cart" show-cart-label="false">
          <div slot="icon" class="site-header__cart">
            <i class="header-btn__icon icon sicon-shopping-bag"></i>
            <span>{{ trans('blocks.header.cart') }}</span>
          </div>
        </salla-cart-summary>
      </div>
    </div>

  </div>
</header>

<div id="mainnav" class="main-nav-container site-nav">
  <div class="site-nav__row">
    <custom-main-menu></custom-main-menu>
    {% if important_links %}
      <salla-menu data-testid="store-header-topnav" source="footer" topnav></salla-menu>
    {% endif %}
  </div>
</div>