{# بنود الشريط الإعلاني — يُضمَّن مرّتين في header.twig لإغلاق دورة الحركة.
   كل إعلان حقلان مستقلّان في إعدادات الثيم (نص بترجمته + أيقونة)، لأن
   collection في الإعدادات يُسقط القالب (انظر CLAUDE.md) #}
{% if theme.settings.get('announcement_text_1')|default('')|trim %}
  <span class="announcement-bar__item">
    <span class="announcement-bar__sep" aria-hidden="true">
      <i class="{{ theme.settings.get('announcement_icon_1')|default('sicon-shipping-fast') }}"></i>
    </span>
    <span class="announcement-bar__text">{{ theme.settings.get('announcement_text_1') }}</span>
  </span>
{% endif %}
