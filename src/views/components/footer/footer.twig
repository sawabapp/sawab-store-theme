{#
تذييل المتجر — تصميم صواب.

أربعة أعمدة: العلامة (شعار ووصف وتواصل اجتماعي) · روابط مهمة · تواصل معنا ·
حمّل التطبيق. ثم بطاقة الثقة (شارات سلة والرقم الضريبي)، ثم شريط سفلي فيه
حقوق النشر ووسائل الدفع.

كل مكوّنات سلة باقية كما هي (`salla-menu`, `salla-contacts`, `salla-social`,
`salla-apps-icons`, `salla-trust-badges`, `salla-payments`) — غُيّر ما حولها
فقط. وخطّاف `copyright` باقٍ في موضعه.

`store.description|raw` يأتي من بيانات المتجر لا من إعداد تاجر، فهو ليس من
ثغرة حقن الإعدادات التي أُغلقت في الشريط الإعلاني.
#}
<footer data-testid="store-footer" class="store-footer sawab-footer">
  <div aria-label="footer" class="store-footer__inner">
    <div class="container sawab-footer__grid">

      <div class="sawab-footer__brand">
        <a href="{{ link('/') }}" class="sawab-footer__logo" aria-label="{{ store.name }}">
          {% if store.logo %}
            <img src="{{ store.logo|cdn(175) }}" width="140" height="40" loading="lazy" alt="{{ store.name }}">
          {% else %}
            <span class="sawab-footer__logo-text">{{ store.name }}</span>
          {% endif %}
        </a>

        {% if store.description %}
          <div class="sawab-footer__about">{{ store.description|raw }}</div>
        {% endif %}

        <salla-social data-testid="store-footer-social" class="sawab-footer__social"></salla-social>
      </div>

      <div class="sawab-footer__col">
        <h3>{{ trans('blocks.footer.pages_links') }}</h3>
        <salla-menu data-testid="store-footer-menu" source="footer" with-cookie-preferences></salla-menu>
      </div>

      <div class="sawab-footer__col">
        <h3>{{ trans('common.elements.contact_us') }}</h3>
        <salla-contacts data-testid="store-footer-contacts"></salla-contacts>
      </div>

      <div class="sawab-footer__col sawab-footer__col--apps">
        <salla-apps-icons data-testid="store-footer-apps"></salla-apps-icons>
      </div>

    </div>

    {# بطاقة الثقة: شارات سلة والرقم الضريبي في صندوق واحد #}
    <div class="container">
      <div class="sawab-footer__trust">
        <salla-trust-badges
          data-testid="store-footer-trust-badges"
          {% if theme.settings.get('footer_is_dark') %} dark {% endif %}></salla-trust-badges>

        {% if store.settings.tax.number %}
          <div class="sawab-footer__tax">
            {% if store.settings.tax.certificate %}
              <a class="sawab-footer__tax-img load-img-onclick" data-modal-id="modal-value-tax" href="#/" aria-label="{{ store.settings.tax.number }}">
                <img width="40" height="50" src="{{ 'images/tax.png'|cdn(70,70) }}" loading="lazy" alt="{{ trans('common.elements.tax_number') }}">
              </a>
            {% endif %}
            <div class="sawab-footer__tax-text">
              <span>{{ trans('common.elements.tax_number') }}</span>
              <b>{{ store.settings.tax.number }}</b>
            </div>
          </div>

          {% if store.settings.tax.certificate %}
            <salla-modal data-testid="store-footer-tax-modal" sub-title-first sub-title="{{ trans('common.elements.tax_number') }}" modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
              <div class="flex justify-center max-w-full">
                <img class="w-full" loading="lazy" data-src="{{ store.settings.tax.certificate }}" alt="{{ store.settings.tax.number }}"/>
              </div>
            </salla-modal>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>

  <div class="container sawab-footer__bottom">
    <span class="copyright-text">{% hook copyright %}</span>
    <salla-payments data-testid="store-footer-payments"></salla-payments>
  </div>
</footer>
