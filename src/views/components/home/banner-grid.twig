{#

لكل بنر: `image` (حاسوب) و `mobile_image` (جوال، حتى 768px) و `eyebrow` و `title`
و `subtitle` و `bg` و `btn` و `url`. لون الخلفية إعداد تاجر فيمرّ كمتغيّر CSS مضمّن.

البنر بنسبة ثابتة (كبير 1300×600 / جوال 800×500 · صغير 640×350 / جوال 400×400)
فالصورة بالمقاس المذكور تملؤه تمامًا. و`mobile_image` بـ`|default` لأن البنرات
المحفوظة قبل إضافة الحقل لا تحمل مفتاحه.

البنر رابط كامل حين يُملأ `url`، وإلا فصندوق غير قابل للنقر — فلا نرسم وسم
`<a>` بلا وجهة.
#}
{% set large = component.large|default([]) %}
{% set small = component.small|default([]) %}

{% if large|length or small|length %}
<section data-testid="store-home-banner-grid" class="s-block sawab-bn">

  {% if large|length %}
    <div class="sawab-bn__row sawab-bn__row--large">
      {% for item in large %}
        {% set has_text = item.eyebrow or item.title or item.subtitle or item.btn %}
        {% set mobile_image = item.mobile_image|default('') %}
        {% if item.url %}
          <a href="{{ item.url }}" class="sawab-bn__card sawab-bn__card--large{% if not has_text %} sawab-bn__card--image{% endif %}" style="--bn-bg: {{ item.bg|default('#e63329') }};">
        {% else %}
          <div class="sawab-bn__card sawab-bn__card--large{% if not has_text %} sawab-bn__card--image{% endif %}" style="--bn-bg: {{ item.bg|default('#e63329') }};">
        {% endif %}

          {# بلا نص: الصورة وحدها تملأ البنر (sawab-bn__card--image) #}
          {% if has_text %}
          <div class="sawab-bn__text">
            {% if item.eyebrow %}<span class="sawab-bn__eyebrow">{{ item.eyebrow }}</span>{% endif %}
            {% if item.title %}<h3 class="sawab-bn__title">{{ item.title }}</h3>{% endif %}
            {% if item.subtitle %}<p class="sawab-bn__subtitle">{{ item.subtitle }}</p>{% endif %}
            {% if item.btn %}
              <span class="sawab-bn__btn">
                <i class="sicon-shipping-fast" aria-hidden="true"></i>
                <span>{{ item.btn }}</span>
              </span>
            {% endif %}
          </div>
          {% endif %}

          {% if item.image or mobile_image %}
            <span class="sawab-bn__media">
              <picture>
                {% if mobile_image %}<source media="(max-width: 768px)" srcset="{{ mobile_image|cdn(800) }}" width="800" height="500">{% endif %}
                <img src="{{ item.image|default(mobile_image)|cdn(1300) }}" alt="{{ item.title|default('') }}" loading="lazy" width="1300" height="600">
              </picture>
            </span>
          {% endif %}

        {% if item.url %}</a>{% else %}</div>{% endif %}
      {% endfor %}
    </div>
  {% endif %}

  {% if small|length %}
    <div class="sawab-bn__row sawab-bn__row--small">
      {% for item in small %}
        {% set has_text = item.eyebrow or item.title or item.subtitle %}
        {% set mobile_image = item.mobile_image|default('') %}
        {% if item.url %}
          <a href="{{ item.url }}" class="sawab-bn__card sawab-bn__card--small{% if not has_text %} sawab-bn__card--image{% endif %}" style="--bn-bg: {{ item.bg|default('#e63329') }};">
        {% else %}
          <div class="sawab-bn__card sawab-bn__card--small{% if not has_text %} sawab-bn__card--image{% endif %}" style="--bn-bg: {{ item.bg|default('#e63329') }};">
        {% endif %}

          {% if has_text %}
          <div class="sawab-bn__text">
            {% if item.eyebrow %}<span class="sawab-bn__eyebrow">{{ item.eyebrow }}</span>{% endif %}
            {% if item.title %}<h3 class="sawab-bn__title">{{ item.title }}</h3>{% endif %}
            {% if item.subtitle %}<p class="sawab-bn__subtitle">{{ item.subtitle }}</p>{% endif %}
          </div>
          {% endif %}

          {% if item.image or mobile_image %}
            <span class="sawab-bn__media">
              <picture>
                {% if mobile_image %}<source media="(max-width: 768px)" srcset="{{ mobile_image|cdn(400) }}" width="400" height="400">{% endif %}
                <img src="{{ item.image|default(mobile_image)|cdn(640) }}" alt="{{ item.title|default('') }}" loading="lazy" width="640" height="350">
              </picture>
            </span>
          {% endif %}

        {% if item.url %}</a>{% else %}</div>{% endif %}
      {% endfor %}
    </div>
  {% endif %}

</section>
{% endif %}
