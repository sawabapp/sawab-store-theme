{#

بنرات صور فقط: لكل بنر `image` (حاسوب) و `mobile_image` (جوال، حتى 768px) و `url`.
التصميم كلّه داخل الصورة، والبنر رابط كامل حين يُملأ `url`.

البنر بنسبة ثابتة (كبير 1300×600 / جوال 800×500 · صغير 640×350 / جوال 400×400)
فالصورة بالمقاس المذكور تملؤه تمامًا. و`mobile_image` بـ`|default` لأن البنرات
المحفوظة قبل إضافة الحقل لا تحمل مفتاحه.
#}
{% set large = component.large|default([]) %}
{% set small = component.small|default([]) %}

{% if large|length or small|length %}
<section data-testid="store-home-banner-grid" class="s-block sawab-bn">

  {% if large|length %}
    <div class="sawab-bn__row sawab-bn__row--large">
      {% for item in large %}
        {% set mobile_image = item.mobile_image|default('') %}
        {% if item.image or mobile_image %}
          {% if item.url %}<a href="{{ item.url }}" class="sawab-bn__card sawab-bn__card--large">{% else %}<div class="sawab-bn__card sawab-bn__card--large">{% endif %}
            <picture>
              {% if mobile_image %}<source media="(max-width: 768px)" srcset="{{ mobile_image|cdn(800) }}" width="800" height="500">{% endif %}
              <img src="{{ item.image|default(mobile_image)|cdn(1300) }}" alt="{{ trans('sawab.home.banner') }}" loading="lazy" width="1300" height="600">
            </picture>
          {% if item.url %}</a>{% else %}</div>{% endif %}
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  {% if small|length %}
    <div class="sawab-bn__row sawab-bn__row--small">
      {% for item in small %}
        {% set mobile_image = item.mobile_image|default('') %}
        {% if item.image or mobile_image %}
          {% if item.url %}<a href="{{ item.url }}" class="sawab-bn__card sawab-bn__card--small">{% else %}<div class="sawab-bn__card sawab-bn__card--small">{% endif %}
            <picture>
              {% if mobile_image %}<source media="(max-width: 768px)" srcset="{{ mobile_image|cdn(400) }}" width="400" height="400">{% endif %}
              <img src="{{ item.image|default(mobile_image)|cdn(640) }}" alt="{{ trans('sawab.home.banner') }}" loading="lazy" width="640" height="350">
            </picture>
          {% if item.url %}</a>{% else %}</div>{% endif %}
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

</section>
{% endif %}
