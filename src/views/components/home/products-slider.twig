<section data-testid="store-home-products-slider" id="best-offers-{{ position }}-slider" class="s-block s-block--best-offers sawab-block overflow-hidden">
  {% if products|length %}
    <salla-products-slider
            data-testid="store-home-products-slider-widget"
            source="{{ products.source }}"
            includes='["brand"]'
            limit="{{ limit }}"
            autoplay
            source-value="{{ products.source_value|json_encode }}"
            display-all-url="{{display_all_url}}"
            block-title="{{ title }}"
            block-subTitle="{{ sub_title }}"
            slider-id="slider-with-bg-{{ position }}"
    ></salla-products-slider>
  {% endif %}
</section>
