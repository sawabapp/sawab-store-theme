{#

المقالات تأتي من مدونة المتجر: `home.js` يطلب أحدث 4 من `blog/articles`
ويملأ `<template>` لكلٍّ منها (نصوص بـ`textContent` فلا حقن HTML). ولا منتقي
مقالات يصل القالب في Twilight (اختُبر: يعيد `[]`).

القسم مخفيّ حتى تصل المقالات، ويبقى مخفيًا إن لم توجد أو أُغلقت المدونة.
التاجر يكتب التصنيفات فقط، بالترتيب: الأول للمقال الأحدث.
#}
<section data-testid="store-home-blog-articles" class="s-block sawab-blog" hidden>

  {% if component.title or component.subtitle or component.all_url %}
    <div class="sawab-blog__head">
      <div class="sawab-blog__headings">
        {% if component.title %}<h2 class="sawab-blog__heading">{{ component.title }}</h2>{% endif %}
        {% if component.subtitle %}<p class="sawab-blog__subheading">{{ component.subtitle }}</p>{% endif %}
      </div>
      {% if component.all_url %}
        <a href="{{ component.all_url }}" class="sawab-blog__all">
          <span>{{ trans('sawab.home.all_articles') }}</span>
          <i class="sicon-arrow-left" aria-hidden="true"></i>
        </a>
      {% endif %}
    </div>
  {% endif %}

  <div class="sawab-blog__grid"></div>

  <span hidden>
    {% for item in component.labels|default([]) %}<span data-sawab-blog-label>{{ item.label }}</span>{% endfor %}
  </span>

  <template class="sawab-blog__tpl">
    <a class="sawab-blog__card">
      <span class="sawab-blog__media">
        <img alt="" loading="lazy" width="800" height="450">
        <i class="sicon-book-open sawab-blog__noimg" aria-hidden="true"></i>
        {% if component.badge %}
          <span class="sawab-blog__badge">
            <i class="sicon-star2" aria-hidden="true"></i>
            <span>{{ component.badge }}</span>
          </span>
        {% endif %}
      </span>

      <span class="sawab-blog__body">
        <span class="sawab-blog__meta">
          <span class="sawab-blog__tag"></span>
          <span class="sawab-blog__date">
            <i class="sicon-calendar-date" aria-hidden="true"></i>
            <span></span>
          </span>
        </span>
        <h3 class="sawab-blog__title"></h3>
        <span class="sawab-blog__summary"></span>
        <span class="sawab-blog__more">
          <span>{{ trans('sawab.home.read_article') }}</span>
          <i class="sicon-arrow-left" aria-hidden="true"></i>
        </span>
      </span>
    </a>
  </template>

</section>
