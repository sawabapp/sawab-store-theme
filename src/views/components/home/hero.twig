{#
| Variable | Type | Description |
|----------|------|--------------|
| theme.settings.hero_section_enabled          | bool    |                                                  |
| theme.settings.hero_badge_text               | ?string |                                                  |
| theme.settings.hero_title                    | ?string | السطر الأول من العنوان                          |
| theme.settings.hero_title_highlight_prefix   | ?string | بداية السطر الثاني (بدون تمييز)                  |
| theme.settings.hero_title_highlight          | ?string | نهاية السطر الثاني (بلون العلامة التجارية)        |
| theme.settings.hero_description              | ?string |                                                  |
| theme.settings.hero_image                    | ?string |                                                  |
| theme.settings.hero_whatsapp_number          | ?string | أرقام فقط، مثال: 966500000000                   |
| theme.settings.hero_whatsapp_button_text     | ?string |                                                  |
| theme.settings.hero_shop_button_text         | ?string |                                                  |
| theme.settings.hero_shop_button_link         | ?string |                                                  |
| theme.settings.hero_delivery_title           | ?string |                                                  |
| theme.settings.hero_delivery_description     | ?string |                                                  |
| theme.settings.hero_warranty_title           | ?string |                                                  |
| theme.settings.hero_warranty_description     | ?string |                                                  |
| theme.settings.hero_rating_percentage        | ?string |                                                  |
| theme.settings.hero_rating_count_text        | ?string |                                                  |
| theme.settings.hero_reviews_link             | ?string |                                                  |

هذا القسم ثابت أعلى الصفحة الرئيسية (يُقرأ من إعدادات التصميم مباشرة)،
وليس عنصرًا من منشئ الصفحة — فيظهر تلقائيًا بدون أي إضافة يدوية.
#}
{% set sawab_ar = (language.code|default('ar')) == 'ar' %}
{% set t_reviews_link = sawab_ar ? 'آراء العملاء' : 'Customer reviews' %}
{% set badge_text = theme.settings.get('hero_badge_text') %}
{% set title = theme.settings.get('hero_title') %}
{% set title_highlight_prefix = theme.settings.get('hero_title_highlight_prefix') %}
{% set title_highlight = theme.settings.get('hero_title_highlight') %}
{% set description = theme.settings.get('hero_description') %}
{% set hero_image = theme.settings.get('hero_image') %}
{% set whatsapp_number = theme.settings.get('hero_whatsapp_number') %}
{% set whatsapp_button_text = theme.settings.get('hero_whatsapp_button_text') %}
{% set shop_button_text = theme.settings.get('hero_shop_button_text') %}
{% set shop_button_link = theme.settings.get('hero_shop_button_link') %}
{% set delivery_title = theme.settings.get('hero_delivery_title') %}
{% set delivery_description = theme.settings.get('hero_delivery_description') %}
{% set warranty_title = theme.settings.get('hero_warranty_title') %}
{% set warranty_description = theme.settings.get('hero_warranty_description') %}
{% set rating_percentage = theme.settings.get('hero_rating_percentage') %}
{% set rating_count_text = theme.settings.get('hero_rating_count_text') %}
{% set reviews_link = theme.settings.get('hero_reviews_link') %}

<section data-testid="store-home-hero" class="s-block sawab-hero">
  <div class="sawab-hero__grid">

    <div class="sawab-hero__main">
      <div class="sawab-hero__content">
        {% if badge_text %}
          <span class="sawab-hero__badge">{{ badge_text }}</span>
        {% endif %}

        {% if title %}
          <h2 class="sawab-hero__title">{{ title }}</h2>
        {% endif %}

        {% if title_highlight_prefix or title_highlight %}
          <p class="sawab-hero__title sawab-hero__title--line2">
            {{ title_highlight_prefix }}
            <span class="sawab-hero__title-highlight">{{ title_highlight }}</span>
          </p>
        {% endif %}

        {% if description %}
          <p class="sawab-hero__description">{{ description }}</p>
        {% endif %}

        <div class="sawab-hero__actions">
          {% if whatsapp_number %}
            <a
              href="https://wa.me/{{ whatsapp_number }}"
              target="_blank"
              rel="noopener"
              class="sawab-hero__btn sawab-hero__btn--whatsapp"
            >
              <i class="sicon-whatsapp"></i>
              <span>{{ whatsapp_button_text|default('استشرنا واتساب') }}</span>
            </a>
          {% endif %}

          {% if shop_button_text %}
            <a
              href="{{ shop_button_link|default(store.url) }}"
              class="sawab-hero__btn sawab-hero__btn--shop"
            >
              <span>{{ shop_button_text }}</span>
            </a>
          {% endif %}
        </div>
      </div>

      {% if hero_image %}
        <div class="sawab-hero__image">
          <img
            src="{{ hero_image|cdn(700) }}"
            width="600"
            height="600"
            loading="eager"
            fetchpriority="high"
            alt="{{ title|default(store.name) }}"
          >
        </div>
      {% endif %}
    </div>

    <div class="sawab-hero__side">
      {% if delivery_title or delivery_description %}
        <div class="sawab-hero__card sawab-hero__card--dark">
          <h3 class="sawab-hero__card-title">{{ delivery_title }}</h3>
          <p class="sawab-hero__card-text">{{ delivery_description }}</p>
        </div>
      {% endif %}

      {% if warranty_title or warranty_description %}
        <div class="sawab-hero__card">
          <h3 class="sawab-hero__card-title sawab-hero__card-title--accent">
            <i class="sicon-star2"></i>
            {{ warranty_title }}
          </h3>
          <p class="sawab-hero__card-text">{{ warranty_description }}</p>
        </div>
      {% endif %}

      {% if rating_percentage or reviews_link %}
        <div class="sawab-hero__card sawab-hero__card--rating">
          <div class="sawab-hero__rating-main">
            <div class="sawab-hero__rating-value">
              <i class="sicon-star"></i>
              <span>{{ rating_percentage }}</span>
            </div>
            {% if rating_count_text %}
              <p class="sawab-hero__card-text">{{ rating_count_text }}</p>
            {% endif %}
          </div>

          {% if reviews_link %}
            <a href="{{ reviews_link }}" class="sawab-hero__reviews-link">
              <span>{{ t_reviews_link }}</span>
              <i class="sicon-arrow-left"></i>
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>

  </div>
</section>
