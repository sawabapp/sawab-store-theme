{#
| Variable              | Type      | Description                                                      |
|-----------------------|-----------|------------------------------------------------------------------|
| products.source       | string    |                                                                  |
| products.source_value | ?int[]    | ids of sources (product_ids, categories_ids, brands_id..etc)     |
| title                 | string    | Section title                                                    |
| display_all_url       | ?string   | If it's existed, mean should show load more link to this url     |
| position              | Int       | Sorting number start from zero                                   |
| limit                 | int       | Number of products to be shown                                   |

هذا قسم جاهز من سلة، فحقوله ليست لنا. والتحكّم فيه من إعدادات الثيم العامة:

- `fixed_products_per_row`  عدد المنتجات في الصف (3 … 6)
- `fixed_products_layout`   ما يحدث عند التجاوز: `slider` أو `grid`
- `vertical_fixed_products` البطاقة العمودية — وهي تصميم بطاقات هذا الثيم

في وضع الشريط نمرّر العنوان إلى `salla-products-slider` بسمة `block-title`
ليرسمه مع أزرار التنقّل في سطر واحد، فلا نرسم ترويستنا كي لا يتكرّر العنوان.
#}
{% set is_vertical = theme.settings.get('vertical_fixed_products', true) %}
{% set fp_cols = theme.settings.get('fixed_products_per_row')|default('5') %}
{% set fp_layout = theme.settings.get('fixed_products_layout')|default('slider') %}
{# القسم جاهز من سلة فلا حقول له؛ ورابط «عرض الكل» يأتي من إعدادات الثيم،
   ويرجع إلى display_all_url إن وفّرته سلة #}
{% set fp_all = theme.settings.get('fixed_products_all_url')|default(display_all_url) %}

<section
  data-testid="store-home-fixed-products"
  class="s-block sawab-block sawab-block--cols-{{ fp_cols }}{{ fp_layout == 'slider' ? ' sawab-block--slider overflow-hidden' : '' }}"
>
  {% if fp_layout == 'slider' %}

    <salla-products-slider
      data-testid="store-home-fixed-products-slider"
      source="{{ products.source }}"
      includes='["brand"]'
      limit="{{ limit }}"
      source-value="{{ products.source_value|json_encode }}"
      display-all-url="{{ fp_all }}"
      block-title="{{ title }}"
      slider-id="fixed-products-{{ position }}"
    ></salla-products-slider>

  {% else %}

    {# الترويسة تُرسم إن وُجد عنوان أو رابط: الزر كان محصورًا داخل شرط
       العنوان، فيختفي مع اختفائه #}
    {% if title or fp_all %}
      <div class="s-block__title">
        <div class="right-side">
          {% if title %}<h2>{{ title }}</h2>{% endif %}
        </div>
        {% if fp_all %}
          <a href="{{ fp_all }}" class="s-block__display-all">{{ trans('blocks.home.display_all') }} <i class="sicon-arrow-left"></i></a>
        {% endif %}
      </div>
    {% endif %}

    <salla-products-list
      data-testid="store-home-fixed-products-list"
      source="{{ products.source }}"
      includes='["brand"]'
      limit="{{ limit }}"
      source-value="{{ products.source_value|json_encode }}"
      class="{{ is_vertical ? 'vertical-products' : 'horizontal-products' }}"
      {{ is_vertical ? '' : 'horizontal-cards' }}
      >
    </salla-products-list>

  {% endif %}
</section>
