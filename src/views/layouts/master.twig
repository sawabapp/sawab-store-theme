<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<!-- بسم الله الرحمن الرحيم -->
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ theme.settings.set('placeholder', 'images/placeholder.png') }}

    <script defer data-cfasync="false" crossorigin="anonymous" src="{{ 'product-card.js'|asset }}"></script>
    <script defer src="{{ 'main-menu.js'|asset }}"></script>
    {% if theme.settings.get('enable_add_product_toast', true) %}
        <script defer src="{{ 'add-product-toast.js'|asset }}"></script>
    {% endif %}

    {% block head_scripts %}{% endblock %}


    <script data-cfasync="false">
        window.header_is_sticky = "{{theme.settings.get('header_is_sticky', 'Default Value')}}"
        window.imageZoom = "{{theme.settings.get('imageZoom')}}"
        window.can_access_wallet = {{ user.can_access_wallet | json_encode }}
        window.enable_more_menu = "{{ theme.settings.get('enable_more_menu', true) }}"
        window.enable_add_product_toast = "{{ theme.settings.get('enable_add_product_toast', true) }}"
        window.card_options_enabled = {{ theme.settings.get('card_quick_options', true) ? 'true' : 'false' }}
        window.notify_when_available_in_card = "{{ theme.settings.get('notify_when_available_in_card', true) }}"
        {# إعداد المتجر متاح في twig فقط، فنمرّره للجافاسكربت لتُعرض ملاحظة "شامل الضريبة" أسفل السعر #}
        window.taxable_prices_enabled = {{ store.settings.tax.taxable_prices_enabled | json_encode }}
    </script>
    
    {% hook 'head:start' %}
    {% hook head %}
    {% block styles %}{% endblock %}
    {# خط المتجر من سلة يجلب الوزن 400 وحده، وتصميمنا يعتمد على 500–800
       (العناوين والأسعار والأزرار). كانت الأوزان ‎@import داخل app.css فلا
       تبدأ إلا بعد تنزيله؛ هنا تبدأ بالتوازي معه. ومشروطة بخط المتجر: لو
       غيّره التاجر لا نحمّل IBM بلا داعٍ #}
    {% if (theme.font.name|default('')) starts with 'IBM Plex' %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&display=swap">
    {% endif %}
    <link rel="stylesheet" href="{{ 'app.css' | asset }}">
    <link rel="stylesheet" href="{{ theme.font.path|cdn }}"/>
    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}"/>
    
    <style>
        :root {
            --font-main: '{{theme.font.name}}';
            --color-primary: {{ theme.color.primary }};
            --color-primary-dark: {{ theme.color.darker(0.15) }};
            --color-primary-light: {{ theme.color.lighter(0.15) }};
            --color-primary-reverse: {{ theme.color.reverse_text }};
            /* Theme specific variables */
            --s-radius: .75rem;
        }
    </style>
    {# tracking services, custom css feature. #}
    {% hook 'head:end' %}
</head>
<body id="app" class="theme-raed overflow-x-hidden {% hook 'body:classes' %}
  {{ theme.settings.get('footer_is_dark') ? ' footer-is-dark' : ' footer-is-light' }}
  {{ theme.settings.get('topnav_is_dark') ? ' topnav-is-dark' : '' }}
  {{ theme.settings.get('sticky_add_to_cart') ? ' is-sticky-product-bar' : '' }}
  ">
{# شاشة التحميل: أول عنصر في body، وأنماطها الحرجة داخلية لتعمل قبل app.css.
   تبدأ مخفية ولا تظهر إلا إن مرّت 400ms دون أن تجهز الصفحة — كانت تغطّي
   الصفحة الجاهزة حتى 3.5 ثانية فيبدو المتجر أبطأ مما هو. وإخفاؤها بسكربت
   داخلي لا من app.js، فلو فشل تحميل الحزمة لما بقيت معلّقة أمام العميل #}
<div class="sawab-loader" id="sawab-loader" style="position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;background:rgba(255,255,255,.92)">
    <div class="sawab-loader__box">
        {% if store.logo %}
            <img class="sawab-loader__logo" src="{{ store.logo|cdn(220) }}" alt="{{ store.name }}" width="140" height="40" loading="lazy">
        {% else %}
            <span class="sawab-loader__name">{{ store.name }}</span>
        {% endif %}
        <span class="sawab-loader__bar"><i></i></span>
    </div>
</div>
<script>
    (function () {
        var el = document.getElementById('sawab-loader');
        if (!el) return;
        var done = false;
        var hide = function () {
            if (done) return;
            done = true;
            // لم تظهر أصلًا ⇒ نزيلها بلا حركة خروج
            if (el.style.display === 'none') { el.remove(); return; }
            el.classList.add('is-done');
        };
        setTimeout(function () { if (!done) el.style.display = 'flex'; }, 400);
        // ثلاثة مسارات: جهوزية الثيم، حمل الصفحة، ومهلة قصوى تمنع أي تعليق
        document.addEventListener('theme::ready', hide);
        window.addEventListener('load', hide);
        setTimeout(hide, 3500);
    })();
</script>

<noscript>
    To get full functionality of this site you need to enable JavaScript. Here is how
    <a href="https://www.enable-javascript.com/" rel="noreferrer"
       target="_blank">To enable JavaScript on webpage</a>.
</noscript>
<div class="app-inner flex flex-col min-h-full">
    {% hook 'body:start' %}
    {% component 'header.header' %}
    <main id="main-content" role="main"{{ (page.slug == 'product.single' or page.slug starts with 'product.index') ? ' class="flex flex-col space-y-8 sm:space-y-16"' : '' }}>
    {% block content %}{% endblock %}
    </main>
    {% component 'footer.footer' %}
</div>
{% include 'components.side-cart' %}

{% hook 'body:end' %}
{% if theme.settings.get('enable_add_product_toast', true) %}
    <salla-add-product-toast data-testid="store-add-product-toast"></salla-add-product-toast>
{% endif %}
<script defer crossorigin="anonymous" src="{{ 'app.js' | asset }}"></script>

{# Twilight Components #}
<salla-offer-modal data-testid="store-offer-modal"></salla-offer-modal>
<salla-search data-testid="store-search-modal"></salla-search>
<salla-login-modal data-testid="store-login-modal"></salla-login-modal>
{% if store.settings.is_multilingual or store.settings.currencies_enabled %}
    <salla-localization-modal data-testid="store-header-localization"></salla-localization-modal>
{% endif %}
{% if store.scope %}
    <salla-scopes data-testid="store-scopes" selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
{% endif %}
{% block scripts %}{% endblock %}
</body>
</html>
