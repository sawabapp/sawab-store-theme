{#
بنر صفحة التصنيف.

خمس عشرة خانة في إعدادات الثيم، كل خانة: تصنيف وصورتان (حاسوب وجوال).

خانات مرقّمة لا مجموعة: `collection` في إعدادات الثيم يُسقط الهيدر كاملًا —
جُرّب مرّتين وسقط في الحالتين (انظر CLAUDE.md).

ومنتقي التصنيفات يعيد `{"value": [ids], "source": "categories"}` — كائن غلاف
فيه قائمة معرّفات. والرسم داخل الحلقة لأن `set` داخل `for` لا يبقى أثره
خارجها. وكل وصول إلى `category` يمرّ بـ`default()`: القالب يُضمَّن أيضًا في
صفحات الوسوم والبحث.
#}
{% set sawab_bn_id = category.id|default('') %}

{% if sawab_bn_id %}
  {% set sawab_bn_pick = theme.settings.get('cat_banner_1_cat') %}
  {% if sawab_bn_pick %}
    {% for picked_id in sawab_bn_pick.value|default([]) %}
      {% if picked_id == sawab_bn_id and theme.settings.get('cat_banner_1_image') %}
        <picture class="sawab-cat-banner">
          {% if theme.settings.get('cat_banner_1_mobile') %}
            <source media="(max-width: 768px)" srcset="{{ theme.settings.get('cat_banner_1_mobile') }}">
          {% endif %}
          <img src="{{ theme.settings.get('cat_banner_1_image') }}" alt="{{ category.name|default('') }}" loading="lazy">
        </picture>
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}

