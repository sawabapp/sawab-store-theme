{% extends "layouts.master" %}

{#
  قائمة المقالات: لوحة كريمية (المسار والعنوان والتصنيفات شرائح) ثم المقال
  المميّز ثم شبكة البطاقات. البطاقات أبناء مباشرون لـsalla-infinite-scroll:
  محدّده الافتراضي `salla-infinite-scroll > *` لالتقاط الصفحة التالية.
#}
{% block content %}
    <div class="container sawab-bl">

        <header class="sawab-bl-hero">
            <nav class="sawab-bl-hero__crumbs">
                <salla-breadcrumb></salla-breadcrumb>
            </nav>
            <h1 class="sawab-bl-hero__title">{{ page.title }}</h1>

            {% if categories|length %}
                <nav data-testid="store-blog-categories" class="sawab-bl-cats" aria-label="{{ trans('pages.blog_categories.categories') }}">
                    {% for category in categories %}
                        <a href="{{ category.url }}" class="sawab-bl-cats__item{% if category.is_current %} is-active{% endif %}">{{ category.name }}</a>
                    {% endfor %}
                </nav>
            {% endif %}
        </header>

        {% if slides|length %}
            {% set featured = slides|first %}
            <a href="{{ featured.url }}" class="sawab-bl-featured">
                <span class="sawab-bl-featured__media">
                    {% if featured.image.url|is_placeholder %}
                        <i class="sicon-book-open sawab-bl-noimg" aria-hidden="true"></i>
                    {% else %}
                        <img src="{{ featured.image.url }}" alt="{{ featured.image.alt }}" width="800" height="600">
                    {% endif %}
                </span>
                <span class="sawab-bl-featured__body">
                    <span class="sawab-bl-meta">
                        <span><i class="sicon-calendar-date" aria-hidden="true"></i>{{ featured.created_at|date }}</span>
                        <span><i class="sicon-user" aria-hidden="true"></i>{{ featured.author.name }}</span>
                    </span>
                    <span class="sawab-bl-featured__title">{{ featured.title }}</span>
                    <span class="sawab-bl-featured__summary">{{ featured.summary }}</span>
                    <span class="sawab-bl-more">
                        <span>{{ trans('sawab.home.read_article') }}</span>
                        <i class="sicon-arrow-left" aria-hidden="true"></i>
                    </span>
                </span>
            </a>
        {% endif %}

        {% if articles|length %}
            {% hook 'blog:index.items.start' %}

            <salla-infinite-scroll class="sawab-bl-grid" next-page="{{ articles.next_page }}" autoload>
                {% for article in articles %}
                    <article data-testid="store-blog-article-card" class="list-block sawab-bl-card">
                        <a href="{{ article.url }}" class="sawab-bl-card__media" tabindex="-1" aria-hidden="true">
                            {% if article.image.url|is_placeholder %}
                                <i class="sicon-book-open sawab-bl-noimg"></i>
                            {% else %}
                                <img src="{{ article.image.url }}" alt="{{ article.image.alt }}" loading="lazy" width="400" height="400">
                            {% endif %}
                        </a>

                        <div class="sawab-bl-card__body">
                            <div class="sawab-bl-meta">
                                <span><i class="sicon-calendar-date" aria-hidden="true"></i>{{ article.created_at|date }}</span>
                                <a href="{{ article.author.url }}"><i class="sicon-user" aria-hidden="true"></i>{{ article.author.name }}</a>
                            </div>

                            <h3 class="sawab-bl-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
                            {% if article.summary %}<p class="sawab-bl-card__summary">{{ article.summary }}</p>{% endif %}

                            <div class="sawab-bl-card__foot">
                                <a href="{{ article.url }}" class="sawab-bl-more">
                                    <span>{{ trans('sawab.home.read_article') }}</span>
                                    <i class="sicon-arrow-left" aria-hidden="true"></i>
                                </a>
                                {% if store.settings.blog.allow_likes_and_comments %}
                                    <span class="sawab-bl-counts">
                                        {% if article.likes_count %}<span><i class="sicon-thumbs-up" aria-hidden="true"></i>{{ article.likes_count }}</span>{% endif %}
                                        {% if article.comments_count %}<span><i class="sicon-chat" aria-hidden="true"></i>{{ article.comments_count }}</span>{% endif %}
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </salla-infinite-scroll>

            {% hook 'blog:index.items.end' %}
        {% elseif not slides|length %}
            <div class="no-content-placeholder">
                <i class="sicon-inbox icon"></i>
                <p>{{ trans('pages.blog_categories.no_articles') }}</p>
            </div>
        {% endif %}
    </div>
{% endblock %}
