{% extends "layouts.master" %}

{#
  صفحة المقال: رأس كريمي (المسار والعنوان والتاريخ والكاتب) ثم صورة الغلاف،
  ثم المتن بعرض قراءة مريح وبجانبه «مقالات ذات صلة» لاصقة.
  زر الإعجاب يبقى `#blog-like` بـ<i> ثم <span> العدد: blog.js يعتمد هذه البنية.
#}
{% block content %}
    <div class="container sawab-bl sawab-art">

        <header class="sawab-bl-hero sawab-art__head">
            <nav class="sawab-bl-hero__crumbs">
                <salla-breadcrumb></salla-breadcrumb>
            </nav>
            <h1 class="sawab-bl-hero__title sawab-art__title">{{ article.title }}</h1>
            <div class="sawab-bl-meta sawab-art__meta">
                <span><i class="sicon-calendar-date" aria-hidden="true"></i>{{ article.created_at|date }}</span>
                <a href="{{ article.author.url }}"><i class="sicon-user" aria-hidden="true"></i>{{ article.author.name }}</a>
                {% if store.settings.blog.allow_likes_and_comments %}
                    <button id="blog-like" data-blog-id="{{ article.key }}" class="sawab-art__like" type="button">
                        <i class="sicon-thumbs-up"></i>
                        <span>{{ article.likes_count }}</span>
                    </button>
                    {% if article.comments_count %}
                        <span><i class="sicon-chat" aria-hidden="true"></i>{{ article.comments_count }}</span>
                    {% endif %}
                {% endif %}
            </div>
        </header>

        {% if article.has_image %}
            <figure class="sawab-art__cover">
                <img src="{{ article.image.url }}" alt="{{ article.image.alt }}" title="{{ article.image.alt }}" width="1200" height="600" fetchpriority="high">
            </figure>
        {% endif %}

        <div class="sawab-art__layout">
            <div class="main-content sawab-art__main">
                <article class="sawab-art__body">{{ article.body|replace({'&nbsp;': ' '})|raw }}</article>

                {% if article.tags|length %}
                    <div class="sawab-art__tags">
                        {% for tag in article.tags %}
                            <a href="{{ tag.url }}"><i class="sicon-tag" aria-hidden="true"></i>{{ tag.name }}</a>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if store.settings.blog.allow_likes_and_comments %}
                    <salla-comments data-testid="store-blog-comments" item-id="{{ article.key }}" type="blog"></salla-comments>
                {% endif %}
            </div>

            {% if related|length %}
                <aside class="sawab-art__aside" aria-label="{{ trans('pages.blog_articles.related') }}">
                    <h2 class="sawab-art__aside-title">{{ trans('pages.blog_articles.related') }}</h2>

                    {% hook 'blog:single.items.start' %}

                    {% for item in related %}
                        <a href="{{ item.url }}" class="sawab-art__rel">
                            <span class="sawab-art__rel-media">
                                {% if item.has_image %}
                                    <img src="{{ item.image.url }}" alt="{{ item.image.alt }}" loading="lazy" width="88" height="88">
                                {% else %}
                                    <i class="sicon-book-open sawab-bl-noimg" aria-hidden="true"></i>
                                {% endif %}
                            </span>
                            <span class="sawab-art__rel-body">
                                <time>{{ item.created_at|date }}</time>
                                <span class="sawab-art__rel-title">{{ item.title }}</span>
                            </span>
                        </a>
                    {% endfor %}

                    {% hook 'blog:single.items.end' %}
                </aside>
            {% endif %}
        </div>
    </div>
{% endblock %}
